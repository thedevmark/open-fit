{
  "name": "open-fit",
  "version": "0.1.0",
  "private": true,
  "description": "A gym log for your phone: which machine next, what weight, how recovered. Offline-first, no account.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "howto": "node scripts/howto.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
